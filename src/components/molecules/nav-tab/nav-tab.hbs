<a class="nav-tab{{#if current}} nav-tab--current{{/if}}{{#if class}} {{class}}{{/if}}" href="{{href}}"{{#if current}} aria-current="page"{{/if}}>
  <span class="nav-tab__content">
    {{#if icon}}
    {{> atoms/icon/icon name=icon class="nav-tab__icon"}}
    {{/if}}
    <span>{{label}}</span>
  </span>
</a>
