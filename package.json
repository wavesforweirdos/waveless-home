{
  "name": "decskill-avoris",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.0 || >=24.8.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "npm run lint:ts && npm run lint:css && npm run format:check",
    "lint:ts": "eslint .",
    "lint:css": "stylelint \"src/**/*.scss\"",
    "lint:html": "html-validate \"dist/**/*.html\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "html-validate": "^11.16.1",
    "prettier": "^3.9.9",
    "sass": "^1.105.1",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vite-plugin-handlebars": "^2.0.3"
  }
}
